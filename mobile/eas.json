{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://qa.runflow.club/api/v1",
        "EXPO_PUBLIC_WEB_URL": "https://qa.runflow.club"
      },
      "android": {
        "buildType": "apk"
      },
      "environment": "development"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://qa.runflow.club/api/v1",
        "EXPO_PUBLIC_WEB_URL": "https://qa.runflow.club",
        "ORG_GRADLE_PROJECT_reactNativeArchitectures": "arm64-v8a"
      },
      "android": {
        "buildType": "apk"
      },
      "autoIncrement": true,
      "environment": "preview"
    },
    "production": {
      "autoIncrement": true,
      "environment": "production"
    }
  },
  "submit": {
    "production": {}
  }
}
