  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://qa.runflow.club/api/v1",
        "EXPO_PUBLIC_WEB_URL": "https://qa.runflow.club"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://qa.runflow.club/api/v1",
        "EXPO_PUBLIC_WEB_URL": "https://qa.runflow.club"
      }
    },
    "production": {
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
