  "query": "INSERT INTO memberships (id, club_id, user_id, role) VALUES ($1, $2, $3, $4)\n         ON CONFLICT (club_id, user_id) DO UPDATE SET role = $4, status = 'active', left_at = NULL, joined_at = now()\n         RETURNING id, club_id, user_id, role, status, is_billing_owner, joined_at, left_at",
