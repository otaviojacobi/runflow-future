{
  "db_name": "PostgreSQL",
  "query": "SELECT m.club_id, m.id, coalesce(f.group_ids, '{}') AS \"group_ids!\"\n             FROM memberships m JOIN clubs c ON c.id = m.club_id LEFT JOIN notification_group_filters f ON f.membership_id = m.id\n            WHERE m.user_id = $1 AND m.status = 'active' AND m.role <> 'student' AND c.deleted_at IS NULL\n            ORDER BY m.joined_at",
