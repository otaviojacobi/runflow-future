{
  "db_name": "PostgreSQL",
  "query": "SELECT p.id, p.club_id, p.date, p.sport, p.est_distance_m, p.est_duration_s\n           FROM planned_workouts p JOIN memberships m ON m.id = p.athlete_membership_id\n          WHERE p.id = $1 AND m.user_id = $2 AND m.role = 'student' AND m.status = 'active'\n            AND coalesce(workout_released(p.club_id, p.athlete_membership_id, p.date), false)",
