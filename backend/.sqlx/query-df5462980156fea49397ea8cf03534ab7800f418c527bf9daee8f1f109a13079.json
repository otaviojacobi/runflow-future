  "query": "SELECT u.id, u.email, u.name, u.avatar_url, u.phone, u.birth_date, u.sex, u.locale, u.created_at\n           FROM auth_identities i JOIN users u ON u.id = i.user_id\n          WHERE i.provider = $1 AND i.subject = $2 AND u.deleted_at IS NULL",
