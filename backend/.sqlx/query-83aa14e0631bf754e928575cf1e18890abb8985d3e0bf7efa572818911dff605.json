  "query": "SELECT u.id, u.email, coalesce(p.digest_hour, 7::smallint) AS \"digest_hour!\", p.last_digest_on\n             FROM users u LEFT JOIN notification_prefs p ON p.user_id = u.id\n            WHERE u.deleted_at IS NULL AND EXISTS (SELECT 1 FROM notifications n WHERE n.user_id = u.id AND n.email = 'digest')",
