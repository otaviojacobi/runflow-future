  "query": "SELECT p.athlete_membership_id, count(*) AS \"n!\"\n             FROM planned_workouts p\n            WHERE p.club_id = $1 AND p.date BETWEEN $2 AND $2 + 6\n              AND NOT coalesce(workout_released(p.club_id, p.athlete_membership_id, p.date), false)\n            GROUP BY 1",
