{
  "db_name": "PostgreSQL",
  "query": "SELECT e.id, r.date, r.name, CASE WHEN r.city IS NULL THEN NULL ELSE concat_ws(' · ', r.city, r.state) END AS place\n             FROM race_entries e JOIN races r ON r.id = e.race_id JOIN memberships m ON m.id = e.membership_id\n            WHERE m.user_id = $1 AND m.status = 'active' AND r.archived_at IS NULL AND r.date >= $2\n            ORDER BY r.date",
