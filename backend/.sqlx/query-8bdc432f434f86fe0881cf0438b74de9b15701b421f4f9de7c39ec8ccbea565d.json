  "query": "SELECT id, user_id, club_id, kind, title, body, link, read_at, created_at FROM notifications\n          WHERE user_id = $1 AND in_app AND ($2::timestamptz IS NULL OR (created_at, id) < ($2, $3))\n          ORDER BY created_at DESC, id DESC LIMIT $4",
