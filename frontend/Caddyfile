# Runflow web (QA/production). TLS is terminated by Cloudflare; the tunnel talks to this on :80.
{
	admin off
	auto_https off
}

:80 {
	encode zstd gzip

	# The API, same origin: /api/v1/... → api:3000/v1/...
	handle_path /api/* {
		reverse_proxy api:3000
	}

	# Hashed bundles never change: browsers and Cloudflare keep them for a year. A missing one (an old
	# tab after a deploy) is a plain 404 that nobody caches, never the app shell posing as JS.
	handle /assets/* {
		root * /srv
		@found file
		@missing not file
		header @found Cache-Control "public, max-age=31536000, immutable"
		header @missing Cache-Control "no-store"
		file_server
	}

	# Everything else is the app shell (index.html for every route), sw.js, the manifest and icons.
	# Browsers revalidate on every load; Cloudflare answers from its edge for an hour (cache rule in
	# docs/ops/qa-pi.md §6) and update.sh purges it after each deploy, so the Pi only sees API calls.
	handle {
		root * /srv
		header Cache-Control "no-cache"
		header Cloudflare-CDN-Cache-Control "max-age=3600"
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "camera=(self), geolocation=(), microphone=()"
		-Server
	}
}
