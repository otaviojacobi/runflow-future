{
  "$description": "Runflow design tokens — SOURCE OF TRUTH. Edit this file, then run `node build.mjs`. Never hardcode colors, sizes, radii or durations in app code. Structure follows the DTCG format ($type / $value / {alias}); colors are hex strings. Chromatic 'roles' (solid, onSolid, text, subtle, …) are DERIVED by src/color.js from the seeds below, for light and dark, with guaranteed contrast. See docs/design/design-system.md.",

  "color": {
    "seed": {
      "$type": "color",
      "brand":   { "$value": "#4B4FE8", "$description": "Azul Flow: default PRIMARY color (UI: cor primária). Actions: primary buttons, active tab/nav, links, focus. A club's primary overrides it at runtime." },
      "accent":  { "$value": "#CFF846", "$description": "Volt: default SECONDARY color (UI: cor secundária). Highlights: personal records, streaks, achievements. Never actions or body text. A club's secondary overrides it; with only a primary, the engine derives one (src/color.js deriveSecondary)." },
      "success": { "$value": "#007D3D" },
      "warning": { "$value": "#F5A420" },
      "danger":  { "$value": "#DB2C2F" },
      "info":    { "$value": "#0072B5" }
    },

    "neutral": {
      "$description": "Ink — cool neutral scale generated by neutralScale(hue). Steps: 0 (white) … 1000 (near black).",
      "$extensions": { "club.runflow.derive": { "fn": "neutralScale", "hue": 265 } }
    },

    "zone": {
      "$type": "color",
      "$description": "Training intensity zones (HR / pace / power). Follows the gray→blue→green→orange→red convention athletes already know from their watches. Data-viz only: never for text.",
      "1": { "$value": "#9CACC1", "$description": "Z1 Recuperação" },
      "2": { "$value": "#3496EF", "$description": "Z2 Aeróbico leve" },
      "3": { "$value": "#3FC168", "$description": "Z3 Moderado" },
      "4": { "$value": "#F8962D", "$description": "Z4 Limiar" },
      "5": { "$value": "#ED4042", "$description": "Z5 VO2 / máximo" }
    },

    "sport": {
      "$type": "color",
      "$description": "Modality identity (calendar chips, icons, filters). Always paired with an icon + label, never color alone.",
      "run":      { "$value": "#955BE3", "$description": "Corrida" },
      "swim":     { "$value": "#00A2C5", "$description": "Natação" },
      "bike":     { "$value": "#E3AE28", "$description": "Ciclismo" },
      "strength": { "$value": "#DB428C", "$description": "Musculação / força" },
      "mobility": { "$value": "#26B094", "$description": "Mobilidade / funcional / yoga" },
      "other":    { "$value": "#7A808D", "$description": "Outros" }
    }
  },

  "semantic": {
    "$description": "Neutral semantic roles per mode. Chromatic roles (brand, accent, success, warning, danger, info, sport.*) are generated by color.roles() and are not listed here.",
    "light": {
      "bg": {
        "canvas":        { "$value": "{color.neutral.25}",  "$description": "App background" },
        "surface":       { "$value": "{color.neutral.0}",   "$description": "Cards, sheets, inputs" },
        "surfaceRaised": { "$value": "{color.neutral.0}",   "$description": "Menus, popovers, dialogs (+ shadow)" },
        "sunken":        { "$value": "{color.neutral.50}",  "$description": "Wells, progress tracks, code/quick-text editor" },
        "muted":         { "$value": "{color.neutral.100}", "$description": "Hover rows, neutral chips" },
        "inverse":       { "$value": "{color.neutral.900}", "$description": "Toasts, tooltips" }
      },
      "fg": {
        "default":  { "$value": "{color.neutral.950}", "$description": "Primary text (≥ 7:1)" },
        "muted":    { "$value": "{color.neutral.600}", "$description": "Secondary text (≥ 4.5:1)" },
        "subtle":   { "$value": "{color.neutral.500}", "$description": "Placeholders, meta, icons (≥ 3:1; use sparingly)" },
        "disabled": { "$value": "{color.neutral.400}" },
        "inverse":  { "$value": "{color.neutral.0}" }
      },
      "border": {
        "subtle":  { "$value": "{color.neutral.100}", "$description": "Dividers inside cards" },
        "default": { "$value": "{color.neutral.200}", "$description": "Card edges, separators" },
        "strong":  { "$value": "{color.neutral.500}", "$description": "Input boundaries (≥ 3:1)" }
      },
      "overlay": { "$value": "rgba(10, 12, 17, 0.48)" },
      "shadow": {
        "sm": { "$value": "0 1px 2px rgba(10,12,17,0.06), 0 1px 1px rgba(10,12,17,0.04)" },
        "md": { "$value": "0 4px 12px rgba(10,12,17,0.08), 0 1px 3px rgba(10,12,17,0.06)" },
        "lg": { "$value": "0 12px 32px rgba(10,12,17,0.12), 0 2px 6px rgba(10,12,17,0.06)" }
      }
    },
    "dark": {
      "bg": {
        "canvas":        { "$value": "{color.neutral.1000}" },
        "surface":       { "$value": "{color.neutral.950}" },
        "surfaceRaised": { "$value": "{color.neutral.900}" },
        "sunken":        { "$value": "{color.neutral.1000}" },
        "muted":         { "$value": "{color.neutral.850}" },
        "inverse":       { "$value": "{color.neutral.50}" }
      },
      "fg": {
        "default":  { "$value": "{color.neutral.25}" },
        "muted":    { "$value": "{color.neutral.300}" },
        "subtle":   { "$value": "{color.neutral.500}" },
        "disabled": { "$value": "{color.neutral.700}" },
        "inverse":  { "$value": "{color.neutral.950}" }
      },
      "border": {
        "subtle":  { "$value": "{color.neutral.900}" },
        "default": { "$value": "{color.neutral.850}" },
        "strong":  { "$value": "{color.neutral.600}" }
      },
      "overlay": { "$value": "rgba(0, 0, 0, 0.6)" },
      "shadow": {
        "sm": { "$value": "0 1px 2px rgba(0,0,0,0.40)" },
        "md": { "$value": "0 4px 14px rgba(0,0,0,0.45), 0 1px 3px rgba(0,0,0,0.30)" },
        "lg": { "$value": "0 14px 36px rgba(0,0,0,0.55), 0 2px 6px rgba(0,0,0,0.30)" }
      }
    }
  },

  "font": {
    "family": {
      "$type": "fontFamily",
      "display": { "$value": ["Archivo", "Inter", "system-ui", "sans-serif"], "$description": "Headlines and big numbers. Variable font: use wdth 108–125 for the athletic 'expanded' look." },
      "body":    { "$value": ["Inter", "system-ui", "-apple-system", "Segoe UI", "Roboto", "sans-serif"] },
      "mono":    { "$value": ["ui-monospace", "SFMono-Regular", "Menlo", "Consolas", "monospace"], "$description": "Quick-text workout editor only. System fonts, no download." }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 }, "medium": { "$value": 500 }, "semibold": { "$value": 600 }, "bold": { "$value": 700 }, "black": { "$value": 800 }
    }
  },

  "text": {
    "$description": "Composite text styles (size/lineHeight in px; RN uses the same numbers in dp). letterSpacing in em. 'width' maps to the font-variation 'wdth' axis (display font only).",
    "displayLg": { "family": "display", "size": 48, "lineHeight": 52, "weight": 800, "letterSpacing": -0.02, "width": 112 },
    "displayMd": { "family": "display", "size": 36, "lineHeight": 40, "weight": 800, "letterSpacing": -0.02, "width": 112 },
    "displaySm": { "family": "display", "size": 28, "lineHeight": 34, "weight": 700, "letterSpacing": -0.01, "width": 108 },
    "titleLg":   { "family": "body", "size": 22, "lineHeight": 28, "weight": 700, "letterSpacing": -0.01 },
    "titleMd":   { "family": "body", "size": 18, "lineHeight": 24, "weight": 600, "letterSpacing": -0.005 },
    "titleSm":   { "family": "body", "size": 16, "lineHeight": 22, "weight": 600, "letterSpacing": 0 },
    "bodyLg":    { "family": "body", "size": 18, "lineHeight": 28, "weight": 400, "letterSpacing": 0 },
    "bodyMd":    { "family": "body", "size": 16, "lineHeight": 24, "weight": 400, "letterSpacing": 0 },
    "bodySm":    { "family": "body", "size": 14, "lineHeight": 20, "weight": 400, "letterSpacing": 0 },
    "labelMd":   { "family": "body", "size": 15, "lineHeight": 20, "weight": 600, "letterSpacing": 0 },
    "labelSm":   { "family": "body", "size": 13, "lineHeight": 16, "weight": 600, "letterSpacing": 0.005 },
    "caption":   { "family": "body", "size": 12, "lineHeight": 16, "weight": 500, "letterSpacing": 0.01 },
    "overline":  { "family": "body", "size": 11, "lineHeight": 14, "weight": 700, "letterSpacing": 0.08, "transform": "uppercase" },
    "metricXl":  { "family": "display", "size": 40, "lineHeight": 44, "weight": 700, "letterSpacing": -0.02, "width": 110, "numeric": "tabular" },
    "metricLg":  { "family": "display", "size": 28, "lineHeight": 32, "weight": 700, "letterSpacing": -0.01, "width": 110, "numeric": "tabular" },
    "metricMd":  { "family": "display", "size": 20, "lineHeight": 24, "weight": 700, "letterSpacing": 0, "width": 108, "numeric": "tabular" }
  },

  "space": {
    "$type": "dimension",
    "$description": "4px grid. Keys are multiples of 4px (space.4 = 16px).",
    "0": { "$value": 0 }, "0.5": { "$value": 2 }, "1": { "$value": 4 }, "1.5": { "$value": 6 }, "2": { "$value": 8 },
    "3": { "$value": 12 }, "4": { "$value": 16 }, "5": { "$value": 20 }, "6": { "$value": 24 }, "8": { "$value": 32 },
    "10": { "$value": 40 }, "12": { "$value": 48 }, "16": { "$value": 64 }, "20": { "$value": 80 }
  },

  "radius": {
    "$type": "dimension",
    "none": { "$value": 0 }, "xs": { "$value": 4 }, "sm": { "$value": 6 },
    "md": { "$value": 10, "$description": "Buttons, inputs" },
    "lg": { "$value": 14, "$description": "Cards" },
    "xl": { "$value": 20, "$description": "Sheets, dialogs, phone cards" },
    "2xl": { "$value": 28 }, "full": { "$value": 9999, "$description": "Chips, avatars, pills" }
  },

  "size": {
    "$type": "dimension",
    "controlSm": { "$value": 32 }, "controlMd": { "$value": 40 }, "controlLg": { "$value": 48 },
    "touchMin":  { "$value": 44, "$description": "Minimum hit area on touch devices (iOS 44pt / Android 48dp → we use 48 for primary mobile actions)" },
    "iconSm": { "$value": 16 }, "iconMd": { "$value": 20 }, "iconLg": { "$value": 24 },
    "contentMax": { "$value": 1200 }, "readingMax": { "$value": 680 }, "sidebar": { "$value": 248 }
  },

  "motion": {
    "duration": {
      "$type": "duration",
      "instant": { "$value": 80 }, "fast": { "$value": 140 }, "base": { "$value": 200 }, "slow": { "$value": 320 }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard":   { "$value": [0.2, 0, 0, 1] },
      "emphasized": { "$value": [0.3, 0, 0, 1.15] },
      "exit":       { "$value": [0.3, 0, 1, 1] }
    }
  },

  "breakpoint": {
    "$type": "dimension",
    "sm": { "$value": 640 }, "md": { "$value": 768 }, "lg": { "$value": 1024 }, "xl": { "$value": 1280 }, "2xl": { "$value": 1536 }
  },

  "z": {
    "base": { "$value": 0 }, "sticky": { "$value": 10 }, "dropdown": { "$value": 20 }, "overlay": { "$value": 30 }, "modal": { "$value": 40 }, "toast": { "$value": 50 }
  }
}
