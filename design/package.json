{
  "name": "@runflow/design",
  "version": "0.1.0",
  "private": true,
  "description": "Runflow design tokens, club-theme color engine and assets. Framework-agnostic; consumed by frontend/ and mobile/.",
  "type": "commonjs",
  "engines": { "node": ">=20" },
  "files": ["dist", "src", "assets", "tokens.json"],
  "exports": {
    "./tokens.css": "./dist/tokens.css",
    "./tokens.json": "./dist/tokens.json",
    "./tokens": "./dist/tokens.ts",
    "./color": "./src/color.js",
    "./fonts.css": "./assets/fonts/fonts.css",
    "./color-fixtures.json": "./dist/color-fixtures.json"
  },
  "scripts": {
    "build": "node build.mjs",
    "check": "node build.mjs --check",
    "serve": "node serve.mjs"
  }
}
