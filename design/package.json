{
  "name": "@runflow/design",
  "version": "0.1.0",
  "private": true,
  "description": "Runflow design tokens, club-theme color engine and assets. Framework-agnostic; consumed by frontend/ and mobile/.",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "src",
    "assets",
    "tokens.json"
  ],
  "exports": {
    "./tokens.css": "./dist/tokens.css",
    "./tokens.json": "./dist/tokens.json",
    "./tokens": "./dist/tokens.ts",
    "./color": {
      "types": "./src/color.d.ts",
      "default": "./src/color.js"
    },
    "./logo": {
      "types": "./src/logo.d.ts",
      "default": "./src/logo.js"
    },
    "./logo.svg": "./dist/logo.svg",
    "./logo-mono.svg": "./dist/logo-mono.svg",
    "./fonts.css": "./assets/fonts/fonts.css",
    "./color-fixtures.json": "./dist/color-fixtures.json"
  },
  "scripts": {
    "build": "node build.mjs",
    "check": "node build.mjs --check",
    "serve": "node serve.mjs"
  }
}
