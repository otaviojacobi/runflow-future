{
  "name": "runflow",
  "private": true,
  "description": "Runflow monorepo root. See root.md.",
  "workspaces": [
    "design",
    "frontend",
    "mobile"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node api/mock/server.mjs & npm run dev -w @runflow/frontend",
    "dev:api": "node api/mock/server.mjs",
    "dev:web": "npm run dev -w @runflow/frontend",
    "dev:design": "node design/serve.mjs",
    "seed": "node api/mock/seed.mjs",
    "check": "npm run check:web && npm run check:backend",
    "check:web": "npm run check:design && npm run check:api && npm run check -w @runflow/frontend && npm run check -w @runflow/mobile",
    "check:backend": "bash backend/scripts/check.sh",
    "check:design": "node design/build.mjs --check",
    "check:api": "node api/mock/check.mjs",
    "e2e": "npm run e2e -w @runflow/frontend",
    "dev:mobile": "npm run web -w @runflow/mobile",
    "up": "docker compose up -d --build",
    "doctor": "docker compose run --rm api doctor",
    "icons": "node scripts/brand-icons.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
