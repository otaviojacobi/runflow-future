    {
      "id": 18,
      "type": "logs",
      "title": "Garage logs (warnings and errors only, RUST_LOG=garage=warn)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service=\"garage\"}"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
