      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (job_outcome) (increase(runflow_jobs_runs_total[$__rate_interval]))",
