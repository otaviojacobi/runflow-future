    {
      "id": 5,
      "type": "stat",
      "title": "Hit rate (5 min)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(redis_keyspace_hits_total{job=\"valkey\"}[5m])) / clamp_min(sum(rate(redis_keyspace_hits_total{job=\"valkey\"}[5m])) + sum(rate(redis_keyspace_misses_total{job=\"valkey\"}[5m])), 1e-9)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
