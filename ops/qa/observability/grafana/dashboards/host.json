      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * (1 - max by (mountpoint) (node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay|squashfs|fuse.*\",mountpoint!~\"/run.*|/boot.*\"}) / max by (mountpoint) (node_filesystem_size_bytes{fstype!~\"tmpfs|overlay|squashfs|fuse.*\",mountpoint!~\"/run.*|/boot.*\"}))",
          "legendFormat": "{{mountpoint}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
