    {
      "id": 18,
      "type": "bargauge",
      "title": "Memory against the container's limit",
      "description": "Only services with a mem_limit in the compose file.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service) (container_memory_working_set_bytes{job=\"containers\",service!=\"\"}) / sum by (service) (container_spec_memory_limit_bytes{job=\"containers\",service!=\"\"} > 0)",
          "legendFormat": "{{service}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
