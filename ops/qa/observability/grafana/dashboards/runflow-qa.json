{
  "uid": "runflow-qa",
  "title": "Runflow QA",
  "description": "QA at a glance: every service's health (click a tile for its dashboard), the API, worker, host and logs.",
  "tags": [
    "runflow",
    "qa"
  ],
  "timezone": "America/Sao_Paulo",
  "schemaVersion": 41,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "editable": true,
  "graphTooltip": 1,
  "links": [
    {
      "type": "dashboards",
      "title": "Dashboards",
      "tags": [
        "runflow"
      ],
      "asDropdown": true,
      "keepTime": true,
      "includeVars": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "health",
        "label": "/v1/health",
        "type": "custom",
        "description": "The Docker healthcheck calls /v1/health every 15 s; hidden by default so the panels show real traffic.",
        "query": "hidden : /v1/health,shown : -",
        "options": [
          {
            "text": "hidden",
            "value": "/v1/health",
            "selected": true
          },
          {
            "text": "shown",
            "value": "-",
            "selected": false
          }
        ],
        "current": {
          "text": "hidden",
          "value": "/v1/health"
        },
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Services (click a tile for its dashboard)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "API",
      "description": "UP while the API pushes metrics (every 30 s).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(count(target_info{job=\"runflow\"}) > bool 0) or vector(0)"
        }
      ],
      "links": [
        {
          "title": "Open API",
          "url": "/d/runflow-api"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 0,
        "y": 1
      }
    },
    {
