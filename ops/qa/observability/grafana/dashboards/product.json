    {
      "id": 14,
      "type": "table",
      "title": "Clubs, newest first",
      "description": "Each club's progress through the funnel. A club with students but no workouts in a week needs a call.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        }
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "runflow-db"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "runflow-db"
          },
          "rawSql": "SELECT c.name AS \"Club\", c.created_at AS \"Created\", array_to_string(c.modalities, ', ') AS \"Modalities\", coalesce(s.plan, 'free') AS \"Plan\", (SELECT count(*) FROM memberships m WHERE m.club_id = c.id AND m.role = 'student' AND m.status = 'active') AS \"Students\", (SELECT count(*) FROM memberships m WHERE m.club_id = c.id AND m.role IN ('owner', 'trainer') AND m.status = 'active') AS \"Staff\", (SELECT count(*) FROM invitations i WHERE i.club_id = c.id) AS \"Invites\", (SELECT count(*) FROM invitations i WHERE i.club_id = c.id AND i.accepted_at IS NOT NULL) AS \"Accepted\", (SELECT count(*) FROM planned_workouts pw WHERE pw.club_id = c.id) AS \"Workouts\", (SELECT count(*) FROM planned_workouts pw JOIN workout_completions wc ON wc.planned_workout_id = pw.id WHERE pw.club_id = c.id AND wc.status IN ('completed', 'partial')) AS \"Completed\", (SELECT count(DISTINCT date_trunc('week', pw.date)) FROM planned_workouts pw WHERE pw.club_id = c.id) AS \"Weeks planned\", (SELECT max(pw.created_at) FROM planned_workouts pw WHERE pw.club_id = c.id) AS \"Last planned\" FROM clubs c LEFT JOIN club_subscriptions s ON s.club_id = c.id WHERE c.deleted_at IS NULL ORDER BY c.created_at DESC LIMIT 200",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
