    {
      "id": 11,
      "type": "bargauge",
      "title": "Activation funnel (clubs reaching each step, all time)",
      "description": "The activation funnel (docs/next-steps.md §7). Step 6 is the number to improve.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "runflow-db"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "runflow-db"
          },
          "rawSql": "WITH c AS (SELECT id FROM clubs WHERE deleted_at IS NULL) SELECT '1. Club created' AS step, count(*) AS clubs FROM c UNION ALL SELECT '2. Invited someone', count(DISTINCT i.club_id) FROM invitations i JOIN c ON c.id = i.club_id UNION ALL SELECT '3. Has an active student', count(DISTINCT m.club_id) FROM memberships m JOIN c ON c.id = m.club_id WHERE m.role = 'student' AND m.status = 'active' UNION ALL SELECT '4. Planned a workout', count(DISTINCT pw.club_id) FROM planned_workouts pw JOIN c ON c.id = pw.club_id UNION ALL SELECT '5. A student completed one', count(DISTINCT pw.club_id) FROM workout_completions wc JOIN planned_workouts pw ON pw.id = wc.planned_workout_id JOIN c ON c.id = pw.club_id WHERE wc.status IN ('completed', 'partial') UNION ALL SELECT '6. Planned 2+ weeks', count(*) FROM (SELECT pw.club_id FROM planned_workouts pw JOIN c ON c.id = pw.club_id GROUP BY pw.club_id HAVING count(DISTINCT date_trunc('week', pw.date)) >= 2) t",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "continuous-BlYlRd"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "color",
        "reduceOptions": {
          "calcs": [],
          "fields": "",
          "values": true
        }
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 6
      }
    },
    {
      "id": 12,
      "type": "bargauge",
      "title": "Clubs by plan",
      "datasource": {
        "type": "grafana-postgresql-datasource",
