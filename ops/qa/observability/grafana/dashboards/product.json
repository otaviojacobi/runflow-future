          "rawSql": "SELECT coalesce(s.plan, 'free') AS plan, count(*) AS clubs FROM clubs c LEFT JOIN club_subscriptions s ON s.club_id = c.id WHERE c.deleted_at IS NULL GROUP BY 1 ORDER BY 2 DESC",
