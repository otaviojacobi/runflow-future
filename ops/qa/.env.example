# Runflow QA on the Raspberry Pi. Copy to ops/qa/.env (git-ignored) and fill the blanks.
# Every variable is explained in the repo-root .env.example; these are the QA values.

# ------------------------------------------------------------------ runtime
RUNFLOW_ENV=production
RUST_LOG=info,runflow=info,tower_http=warn
LOG_FORMAT=json
# Image tag to run: qa (latest main) or a commit tag like sha-59340b1 (to pin or roll back).
RUNFLOW_TAG=qa

# ------------------------------------------------------------------ public URLs
PUBLIC_APP_URL=https://qa.runflow.club
# The API is served by the same host under /api (no CORS needed).
PUBLIC_API_URL=https://qa.runflow.club/api
CORS_ORIGINS=https://qa.runflow.club
# Keep empty until club subdomains (<club>.qa.runflow.club) ship; then .qa.runflow.club
COOKIE_DOMAIN=

# ------------------------------------------------------------------ Cloudflare Tunnel
TUNNEL_TOKEN=

# ------------------------------------------------------------------ database (created on first start)
POSTGRES_USER=runflow
# letters and digits only: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=runflow
DATABASE_MAX_CONNECTIONS=10

# ------------------------------------------------------------------ secrets: openssl rand -base64 32 (each)
SESSION_SECRET=
# Never change ENCRYPTION_KEY once people connected Strava (their tokens become unreadable).
ENCRYPTION_KEY=

# ------------------------------------------------------------------ e-mail (Resend)
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM="Runflow <contato@runflow.club>"
EMAIL_REPLY_TO=contato@runflow.club

# ------------------------------------------------------------------ Google (web sign-in button arrives with S9)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------------ Strava
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_WEBHOOK_VERIFY_TOKEN=

# ------------------------------------------------------------------ storage, assistant, observability
STORAGE_BACKEND=disk
AI_PROVIDER=rules
SENTRY_DSN=
