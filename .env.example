# Runflow: every setting the backend reads (backend/crates/runflow/src/config.rs).
# Copy to `.env` (git-ignored) and fill in. Read by `docker compose` and by `cargo run` (dotenv).
# Empty means "not set". Check what's configured with:  docker compose run --rm api doctor
# Comments stay on their own lines (some .env parsers don't support inline comments).

# ------------------------------------------------------------------ runtime
# development | production (production refuses missing secrets, http URLs and the log e-mail provider)
RUNFLOW_ENV=development
RUST_LOG=info,runflow=debug,tower_http=info
# pretty | json (default: json in production)
LOG_FORMAT=pretty
HOST=0.0.0.0
# Port the API listens on (inside the container, and for `cargo run`).
PORT=3000
# Host port docker compose publishes the API on. 8080 is the web app, 8787 the mock API.
API_HOST_PORT=3000

# ------------------------------------------------------------------ public URLs
# Links in e-mails point to the web app; OAuth/webhook callbacks to the API.
PUBLIC_APP_URL=http://localhost:8080
PUBLIC_API_URL=http://localhost:3000
# Browser origins allowed to call the API (web app, Expo web). Comma-separated.
CORS_ORIGINS=http://localhost:8080,http://localhost:8082
# Empty = this host only (the default).
COOKIE_DOMAIN=
# Session cookie name, distinct per environment so a cookie set for one never counts in another (QA: rf_session_qa).
COOKIE_NAME=rf_session

# ------------------------------------------------------------------ database
# docker compose creates this database on first start. Use a URL-safe password (letters and digits).
POSTGRES_USER=runflow
POSTGRES_PASSWORD=
POSTGRES_DB=runflow
# Host port for Postgres (5432 is often taken by a local Postgres).
POSTGRES_HOST_PORT=5433
# For `cargo run` / `cargo test` on the host. docker compose overrides it inside its network.
DATABASE_URL=postgres://runflow:CHANGE_ME@localhost:5433/runflow
DATABASE_MAX_CONNECTIONS=10

# ------------------------------------------------------------------ secrets
# Generate each with:  openssl rand -base64 32
# HMAC key for session tokens and e-mail sign-in codes (S2). Required in production.
SESSION_SECRET=
# Encrypts provider tokens (Strava) at rest (S5). Required in production. Never change it once used.
ENCRYPTION_KEY=
# Smoke tests on deployed environments (D-034): with this value in X-Smoke-Key, sign-in for @smoke.runflow.club
# answers the code (those addresses never get e-mail). Same value as the GitHub secret SMOKE_KEY. Empty = off.
SMOKE_KEY=

# ------------------------------------------------------------------ e-mail (Resend, D-026)
# resend | log. Empty: resend when RESEND_API_KEY is set, otherwise log (e-mails printed to the server log).
EMAIL_PROVIDER=
# resend.com → API Keys → Create ("Sending access" is enough). Starts with re_
RESEND_API_KEY=
# Sender. The domain must be verified in Resend (resend.com/domains: add runflow.club, then the DNS records).
# Before that, use: Runflow <onboarding@resend.dev>  (Resend then only delivers to your own account e-mail).
EMAIL_FROM="Runflow <contato@runflow.club>"
# Optional: where replies go, e.g. contato@runflow.club
EMAIL_REPLY_TO=
# Later: Resend webhook (bounces, complaints) signing secret, whsec_...
RESEND_WEBHOOK_SECRET=

# ------------------------------------------------------------------ sign in with Google (S2)
# console.cloud.google.com → APIs & Services → Credentials → Create OAuth client ID → Web application.
# Authorized JavaScript origins: http://localhost:8080 (dev) and https://app.runflow.club (sign-in only
# happens there). No redirect URI needed.
# Empty = "Entrar com o Google" answers 503 and people use the e-mail code.
GOOGLE_CLIENT_ID=
# Not needed for sign-in (the app sends ID tokens); only for future server-side Google APIs.
GOOGLE_CLIENT_SECRET=
# Native sign-in in the mobile app (Phase 3): Android and iOS OAuth clients.
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# ------------------------------------------------------------------ Strava (S5)
# strava.com/settings/api. Authorization Callback Domain: the host of PUBLIC_APP_URL (Strava sends people
# back to <PUBLIC_APP_URL>/connect/strava). Webhook callback URL: <PUBLIC_API_URL>/v1/webhooks/strava.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Any random string; Strava echoes it back when the webhook subscription is created.
STRAVA_WEBHOOK_VERIFY_TOKEN=

# ------------------------------------------------------------------ Stripe (S7, B3; plans by seats D-043)
# Test-mode key (sk_test_...) from dashboard.stripe.com/test/apikeys. With it set, checkout, plan changes and the portal
# go to Stripe and the billing simulation switches off. Then run once (safe to repeat):
#   runflow stripe-setup --env-file <this file>
# It creates the prices from api/plans.json (lookup keys runflow_pro_monthly, runflow_max_monthly,
# runflow_max_extra_trainer_monthly, runflow_max_extra_student_monthly), the Billing Portal configuration and the
# webhook endpoint <PUBLIC_API_URL>/v1/webhooks/stripe, and writes STRIPE_WEBHOOK_SECRET into the env file.
STRIPE_SECRET_KEY=
# The webhook endpoint's signing secret (whsec_...), written by `runflow stripe-setup`.
STRIPE_WEBHOOK_SECRET=
# Without Stripe: owners "pay" on the app's /dev/stripe test pages, nothing is charged (like the mock).
# Default: true in development, false in production (no upgrades at all until Stripe is set up).
BILLING_SIMULATION=true

# ------------------------------------------------------------------ push (S7b)
# Web Push for the installed web app. Generate the pair once: `cargo run -- vapid-keys` (or
# `docker compose run --rm api vapid-keys`). Changing it makes every device turn push on again.
# Empty = no push to devices (the center and e-mail still work).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact for the push services (mailto: or https:).
VAPID_SUBJECT=mailto:contato@runflow.club
# The phone app's push goes through Expo's push service (free, nothing to set). Only if the Expo project turns on
# enhanced push security: its access token.
EXPO_ACCESS_TOKEN=

# ------------------------------------------------------------------ file storage (avatars, logos) · D-037
# s3 (Garage locally and on the Pi, any S3 in production) | disk (quick runs without Garage)
STORAGE_BACKEND=s3
# disk only: folder for uploads. Empty = ./data/uploads.
STORAGE_DIR=
# S3: docker compose runs Garage and points the API at http://garage:3900 itself; this endpoint is for the API
# running on the host (`cargo run -- serve`). Production: the provider's endpoint (empty = AWS) and region.
S3_BUCKET=runflow
S3_REGION=garage
S3_ENDPOINT=http://localhost:3900
# The API's key. Garage creates it on first start from these same values:
#   AWS_ACCESS_KEY_ID = GK + `openssl rand -hex 16`, AWS_SECRET_ACCESS_KEY = `openssl rand -hex 32`
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Garage's internal RPC secret: `openssl rand -hex 32` (Garage only)
GARAGE_RPC_SECRET=

# ------------------------------------------------------------------ assistant (open question: root.md §11.4)
# rules (deterministic, nothing leaves the server) | anthropic
AI_PROVIDER=rules
ANTHROPIC_API_KEY=
AI_MODEL=

# ------------------------------------------------------------------ observability: errors (S12, D-033)
# sentry.io → two projects: Rust (the API and worker) and React (the web app). Empty = off.
SENTRY_DSN=
# The web app's DSN, handed to the browser by /public/config (browser DSNs are public).
SENTRY_WEB_DSN=
# Telemetry (S13): traces, metrics and logs over OTLP/HTTP. Grafana Cloud → your stack → OpenTelemetry → the OTLP
# endpoint (https://otlp-gateway-prod-<region>.grafana.net/otlp) and "Authorization=Basic%20<base64 instanceId:token>".
# Empty = off (logs still go to stdout).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=runflow
# Share of traces kept (0–1) and the metrics export interval in ms.
OTEL_TRACES_SAMPLER_ARG=1
OTEL_METRIC_EXPORT_INTERVAL=60000
# The environment's name in Sentry and telemetry: development | qa | production (default from RUNFLOW_ENV)
DEPLOYMENT_ENV=
